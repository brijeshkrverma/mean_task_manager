# Copy to .env and fill in real values. Never commit .env.

# --- API ---
NODE_ENV=development
PORT=3000
API_PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:4200

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# --- MongoDB ---
MONGO_DB=task_manager
#
# ⚠️ YE FILE GIT ME COMMIT HOTI HAI AUR REPO PUBLIC HAI.
#    Yahan kabhi asli password mat likhna. Asli values sirf `.env` me
#    (wo .gitignore me hai) ya Render dashboard me jaati hain.
#
# Teen options — jo chal raha hai uske hisaab se choose karein:
#
# 1) Local mongo, host se `npm run dev`:
#      MONGO_URI=mongodb://127.0.0.1:27017/task_manager
#
# 2) docker compose (local mongo container):
#      MONGO_URI ko comment kar dein — compose khud `mongo` container use karega
#
# 3) MongoDB Atlas (cloud):
#      MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/task_manager?retryWrites=true&w=majority
#
#      ⚠️ Hostname ke baad `/task_manager` likhna ZAROORI hai. Atlas ka
#         "Connect" wala string `/?appName=...` deta hai — usme database ka
#         naam hota hi nahi, aur phir Mongoose chupchaap `test` database me
#         likhne lagta hai. Ye pakadna mushkil bug hai.
#      ⚠️ Password me @ : / ? # jaise characters hain to URL-encode karein
#         (@ = %40), warna connection string toot jaayegi.
#
MONGO_URI=mongodb://127.0.0.1:27017/task_manager

# --- Redis / queue ---
REDIS_URL=redis://127.0.0.1:6379
TASK_QUEUE_NAME=task-events
WORKER_CONCURRENCY=5
# Queueing is best-effort; give up after this long so a down Redis can't stall requests.
ENQUEUE_TIMEOUT_MS=2000

# --- Web ---
WEB_PORT=8080

# --- Ops (backup.sh / restore.sh / deploy.sh) ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PATH=/srv/mean-task-manager
