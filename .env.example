# Copy to .env and fill in real values. Never commit .env.

# --- API ---
NODE_ENV=development
PORT=3000
API_PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:4200

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# --- MongoDB ---
MONGO_DB=task_manager
MONGO_URI=mongodb://127.0.0.1:27017/task_manager

# --- Redis / queue ---
REDIS_URL=redis://127.0.0.1:6379
TASK_QUEUE_NAME=task-events
WORKER_CONCURRENCY=5
# Queueing is best-effort; give up after this long so a down Redis can't stall requests.
ENQUEUE_TIMEOUT_MS=2000

# --- Web ---
WEB_PORT=8080

# --- Ops (backup.sh / restore.sh / deploy.sh) ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PATH=/srv/mean-task-manager
